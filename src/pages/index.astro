---
/**
 * Homepage - CMS-driven content page
 * Displays hero section, features grid, and CTA from content.json
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import fs from 'node:fs'
import path from 'node:path'

// Read CMS content
const homepageContent = JSON.parse(
  fs.readFileSync(
    path.join(process.cwd(), 'src/content/homepage/content.json'),
    'utf-8'
  )
)

const settings = JSON.parse(
  fs.readFileSync(
    path.join(process.cwd(), 'src/content/settings/general.json'),
    'utf-8'
  )
)

const { hero, features, cta } = homepageContent

// Icon mapping for feature cards
const iconMap: Record<string, string> = {
  lightning: 'M13 10V3L4 14h7v7l9-11h-7z',
  pencil: 'M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z',
  palette: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9zM6.5 12c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z',
}

function getIconPath(icon: string): string {
  return iconMap[icon] || iconMap.lightning
}
---

<BaseLayout title={settings.site_title} description={settings.default_description}>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-text mb-6 leading-tight">
          {hero.headline}
        </h1>
        <p class="text-lg sm:text-xl md:text-2xl text-text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
          {hero.subheadline}
        </p>
        <a
          href={hero.cta_link}
          class="inline-block bg-primary text-background px-8 py-4 font-semibold text-lg transition-all duration-200 hover:opacity-90 hover:translate-y-[-2px]"
        >
          {hero.cta_text}
        </a>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-surface">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature: { title: string; description: string; icon: string }) => (
            <div class="p-6 sm:p-8 bg-background border border-border transition-all duration-200 hover:border-primary/50">
              <!-- Icon -->
              <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary/10 text-primary">
                <svg
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={getIconPath(feature.icon)} />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-text mb-3">
                {feature.title}
              </h3>
              <p class="text-text-muted leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <div class="p-8 sm:p-12 bg-surface border border-border">
          <h2 class="text-3xl sm:text-4xl font-bold text-text mb-4">
            {cta.heading}
          </h2>
          <p class="text-lg text-text-muted mb-8 max-w-xl mx-auto">
            {cta.description}
          </p>
          <a
            href={cta.button_link}
            class="inline-block bg-primary text-background px-8 py-4 font-semibold text-lg transition-all duration-200 hover:opacity-90 hover:translate-y-[-2px]"
          >
            {cta.button_text}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
